@{
    ViewBag.Title = "Đăng nhập";
    Layout = "~/Views/Shared/_MasterLayout.cshtml";
    var customers = ViewBag.Customers as List<MyStore_MVC5.Models.Customers>;
}

<div class="row" style="margin-top:20px;">
    <div class="col-md-5">
        <h3>Đăng nhập Khách hàng</h3>

        @* Đăng ký thành công: hiển thị thông báo *@
        @if (TempData["RegisterSuccess"] != null)
        {
            <div class="alert alert-success">@TempData["RegisterSuccess"]</div>
        }

        @* Đăng nhập thất bại: hiển thị thông báo *@
        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">@ViewBag.Error</div>
        }

        @using (Html.BeginForm("Login", "Account", FormMethod.Post))
        {
            <div class="form-group">
                <label>Tài khoản</label>
                <input type="text" name="username" class="form-control" value="phucnd" required />
            </div>
            <div class="form-group">
                <label>Mật khẩu</label>
                <input type="password" name="password" class="form-control" value="123" required />
            </div>
            <button type="submit" class="btn btn-primary">Đăng nhập</button>
            <a href="@Url.Action("Register", "Account")" class="btn btn-link">Chưa có tài khoản? Đăng ký</a>
        }
    </div>
    <div class="col-md-6 col-md-offset-1">
        <h4>Tài khoản mẫu có sẵn trong DB:</h4>
        @if (customers != null)
        {
            <table class="table table-bordered">
                <tr><th>Họ tên</th><th>Username</th><th>Password</th><th></th></tr>
                @foreach (var c in customers)
                {
                    <tr>
                        <td>@c.FullName</td>
                        <td>@c.Username</td>
                        <td>@c.Password</td>
                        <td><a href="@Url.Action("QuickSwitch", "Account", new { id = c.CustomerID })" class="btn btn-xs btn-success">Đăng nhập nhanh</a></td>
                    </tr>
                }
            </table>
        }
    </div>
</div>
